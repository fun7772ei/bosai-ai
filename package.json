{
  "name": "bosai-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "dev:research": "vite --host 0.0.0.0 --open /bosai-ai/research.html",
    "build:research": "BOSAI_RESEARCH=1 vite build",
    "dev:ruri": "vite --config vite.ruri.config.js --host 0.0.0.0 --open /bosai-ai/ruri-study.html",
    "build:ruri": "vite build --config vite.ruri.config.js",
    "preview:ruri": "vite preview --config vite.ruri.config.js --host 0.0.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@wllama/wllama": "3.8.1",
    "@wllama/wllama-compat": "3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "fake-indexeddb": "^6.2.5",
    "vite": "8.3.4"
  }
}
